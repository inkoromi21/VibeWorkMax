[Unit]
Description=VibeWork MAX worker
After=network-online.target postgresql.service redis-server.service vibework-max-api.service
Wants=network-online.target

[Service]
Type=simple
User=vibework
Group=vibework
WorkingDirectory=/opt/vibeworkmax
EnvironmentFile=/etc/vibework-max/vibework-max.env
ExecStart=/usr/bin/node apps/worker/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
