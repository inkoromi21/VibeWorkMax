NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WEB_PORT=4173
WORKER_HEALTH_PORT=3001
DATABASE_URL=postgresql://vibework:vibework_local@postgres:5432/vibework
REDIS_URL=redis://redis:6379
S3_MODE=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vibework-local
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only
CLAMAV_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_MODE=disabled
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
MAX_MINI_APP_URL=
MINI_APP_DEV_AUTH=disabled
CONSENT_DOCUMENT_VERSION=
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=
AGE_POLICY_VERSION=
MIN_AGE=
REPRESENTATIVE_CONSENT_UNDER=
MAX_IDENTITY_ENCRYPTION_KEY=
YANDEX_AI_MODE=disabled
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL_ALICE_FLASH_URI=
YANDEX_MODEL_ALICE_URI=
YANDEX_MODEL_YANDEXGPT_PRO_5_1_URI=
# Defaults to the documented OpenAI-compatible API base URL when unset.
YANDEX_AI_BASE_URL=
# Required before real AI operations can be enabled. Values are intentionally blank
# until finance approves a versioned provider/model tariff catalogue and limits.
AI_BUDGET_MODE=disabled
MAX_OPERATION_COST=
DAILY_AI_BUDGET=
AI_PRICING_CONFIG_JSON=
# Benchmark live mode additionally requires a confirmed comma-separated list of
# configured model URIs and an approved bounded test budget. Never commit values.
BENCHMARK_CONFIRMED_MODEL_URIS=
BENCHMARK_TEST_BUDGET=
BENCHMARK_RUNS=2
ANALYTICS_MODE=disabled
NOTIFICATION_MODE=mock
